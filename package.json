{
  "name": "spectrum-buddy",
  "version": "1.2.8",
  "description": "Chrome Extension to fetch assignment deadlines from Spectrum LMS",
  "type": "module",
  "scripts": {
    "dev:chrome": "cross-env EXTENSION_TARGET=chrome vite",
    "dev:firefox": "cross-env EXTENSION_TARGET=firefox vite",
    "build:chrome": "cross-env EXTENSION_TARGET=chrome vite build",
    "build:firefox": "cross-env EXTENSION_TARGET=firefox vite build",
    "build:all": "npm run build:chrome && npm run build:firefox",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11"
  }
}
